// messaging_app/Jenkinsfile
pipeline {
    agent any
    options {
        timestamps()
    }
    environment {
        VENV = "${WORKSPACE}/messaging_app/.venv"
        REQ  = "${WORKSPACE}/messaging_app/requirements.txt"
        DOCKER_IMAGE = "geonjogu23/messaging-app"
    }
    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout([$class: 'GitSCM',
                          branches: [[name: '*/master']],
                          userRemoteConfigs: [[
                              url: 'https://github.com/Geoffy1/alx-backend-python.git',
                              credentialsId: 'github-credentials'
                          ]]
                ])
                // ALX checker requires this
                sh 'git branch'
            }
        }

        stage('Preflight: Docker available?') {
            steps {
                sh '''
                    set -e
                    if ! which docker >/dev/null 2>&1; then
                        echo "Docker CLI not found in PATH"; exit 1;
                    fi
                    docker --version || { echo "Docker not responding"; exit 1; }
                    docker ps >/dev/null || { echo "Cannot talk to Docker daemon"; exit 1; }
                '''
            }
        }

        // ... (rest of the Jenkinsfile)
stage('Set up Python venv & Install deps') {
  steps {
    sh '''
      set -e
      cd messaging_app
      python3 -m venv .venv
      . .venv/bin/activate
      python3 -m pip install --upgrade pip
      if [ -f requirements.txt ]; then
        pip3 install -r requirements.txt
      else
        echo "requirements.txt not found; continuing..."
      fi
      # Ensure pytest & coverage exist even if not in requirements
      pip3 install pytest pytest-django coverage
    '''
  }
}
// ... (rest of the Jenkinsfile)

        stage('Run tests + JUnit report') {
            steps {
                sh '''
                    set -e
                    cd messaging_app
                    . .venv/bin/activate
                    pytest --junitxml=test-report.xml -q || true
                '''
            }
            post {
                always {
                    junit 'messaging_app/test-report.xml'
                }
            }
        }

        stage('Build & Push Docker image') {
            steps {
                sh '''
                    set -e
                    cd messaging_app
                    docker build -t "$DOCKER_IMAGE:${BUILD_NUMBER}" -t "$DOCKER_IMAGE:latest" .
                    echo "Built $DOCKER_IMAGE:${BUILD_NUMBER} and :latest"
                '''
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        set -e
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push "$DOCKER_IMAGE:${BUILD_NUMBER}"
                        docker push "$DOCKER_IMAGE:latest"
                    '''
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'messaging_app/test-report.xml', onlyIfSuccessful: false
        }
    }
}
