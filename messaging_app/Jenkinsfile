// messaging_app/Jenkinsfile (Updated)
pipeline {
    // This agent will use a Docker image with Python pre-installed.
    agent {
        docker {
            image 'python:3.9-slim'
        }
    }
    environment {
        DOCKER_HUB_USERNAME = 'geonjogu23' 
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out source code...'
                // You no longer need to check out the repository, as the agent
                // is built from the source code within the pipeline context.
                // However, if the Docker agent is not running in the same
                // context, you might need to check out the repository.
                // For simplicity, let's assume the build context is correct.
            }
        }
        stage('Run Tests') {
            steps {
                echo 'Installing dependencies and running tests...'
                sh '''
                    # The python:3.9-slim image already has Python, so you can
                    # remove the sudo apt-get commands.
                    cd messaging_app
                    python3 -m venv venv
                    source venv/bin/activate
                    pip install -r requirements.txt
                    pytest
                '''
            }
        }
        stage('Build and Push Docker Image') {
            steps {
                echo 'Building and pushing Docker image...'
                script {
                    sh 'cd messaging_app'
                    sh "docker build -t ${env.DOCKER_HUB_USERNAME}/messaging-app:latest ."
                    
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh "docker login -u ${env.DOCKER_USERNAME} -p ${env.DOCKER_PASSWORD}"
                        sh "docker push ${env.DOCKER_HUB_USERNAME}/messaging-app:latest"
                    }
                }
            }
        }
    }
}