// messaging_app/Jenkinsfile (Updated)
pipeline {
    agent any
    environment {
        // Define an environment variable for your Docker Hub username
        DOCKER_HUB_USERNAME = root //'your-dockerhub-username'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out source code...'
                git branch: 'master', credentialsId: 'github-credentials', url: 'https://github.com/Geoffy1/alx-backend-python.git'
            }
        }
        stage('Run Tests') {
            steps {
                echo 'Installing dependencies and running tests...'
                sh '''
                    cd messaging_app
                    python3 -m venv venv
                    source venv/bin/activate
                    pip install -r requirements.txt
                    pytest
                '''
            }
        }
        stage('Build and Push Docker Image') {
            steps {
                echo 'Building and pushing Docker image...'
                script {
                    sh 'cd messaging_app'
                    // Build the Docker image, tagging it with the Docker Hub username and image name
                    sh "docker build -t ${env.DOCKER_HUB_USERNAME}/messaging-app:latest ."
                    
                    // Log in to Docker Hub securely using Jenkins credentials
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh "docker login -u ${env.DOCKER_HUB_USERNAME} -p ${env.DOCKER_PASSWORD}"
                        
                        // Push the image to Docker Hub
                        sh "docker push ${env.DOCKER_HUB_USERNAME}/messaging-app:latest"
                    }
                }
            }
        }
    }
}